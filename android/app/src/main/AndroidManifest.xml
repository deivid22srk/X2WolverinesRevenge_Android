<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifesto do launcher.

  Duas decisões que merecem justificativa:

  * `screenOrientation="fullSensor"` — o pedido é permitir retrato E paisagem.
    "fullSensor" (e não "unspecified") faz a rotação seguir o sensor mesmo com
    a rotação automática do sistema desligada, que é o que se espera de um
    jogo que já traz o próprio overlay de controles nas duas orientações.

  * `configChanges` — quando o usuário gira o aparelho, o jogo NÃO pode ser
    recriado: o contexto nativo (x2rw_ctx) já está rodando código lifted na
    thread de jogo. Recriar a Activity significaria perder esse estado. A
    Activity apenas reajusta o SurfaceView/overlay.

  * Permissões de armazenamento — este é o ponto que derrubou o jogo no
    primeiro teste em aparelho real. O log (motorola edge 30 fusion,
    Android 13) mostrou:
        abrir .../Wolvie.exe: Permission denied
    Causa: no Android 11+ o `stat` em /storage/emulated/0 é permitido, mas o
    `open()` não. O launcher validava a pasta com File.isDirectory (um stat)
    e passava; quem falhava era o fopen() do código nativo. O SAF
    (OpenDocumentTree) **não** resolve isso sozinho: ele dá acesso por
    content:// URI, e o port abre arquivos por caminho (data.pkr, wavs.pkr,
    movies/*.bik, Wolvie.ini), porque o jogo inteiro é escrito assim.

    Por isso:
      - MANAGE_EXTERNAL_STORAGE (API 30+) — "Todos os arquivos". É a única
        forma de manter I/O por caminho. O usuário precisa conceder em
        Configurações; o launcher abre essa tela e explica o motivo.
      - READ_EXTERNAL_STORAGE até a API 32 — é o que basta até o Android 12L,
        e lá é pedido em tempo de execução.
      - requestLegacyExternalStorage — só tem efeito na API 29, onde o
        "legado" ainda existe.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Necessária para abrir os arquivos do jogo por caminho na API 30+.
         O lint do Google reclama (ScopedStorage), mas o port não tem como
         migrar para SAF sem reescrever todo o I/O do jogo. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- O jogo em si é single-player (sem Winsock nos imports). A permissão
         fica declarada apenas para o launcher poder exibir a documentação
         online no futuro; não é usada hoje. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Sem tela de toque o overlay de controles não serve para nada, mas o
         APK ainda instala (útil em TV box com gamepad). Por isso `required`
         fica false e o launcher avisa. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:glEsVersion="0x00020000"
        android:required="false" />

    <!-- requestLegacyExternalStorage só vale na API 29 (Android 10); nas
         seguintes quem manda é a permissão acima. -->
    <application
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true"
        android:hardwareAccelerated="true"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="false"
        android:theme="@style/Theme.X2WR">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:screenOrientation="fullSensor">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
