<?xml version="1.0" encoding="utf-8"?>
<!--
  Tema do launcher.

  Decisões:
  * Base Material3 (o :app depende de com.google.android.material).
  * Sem ActionBar: a tela é do jogo; uma barra de título só roubaria altura
    e mudaria o tamanho do SurfaceView.
  * Janela sem fundo opaco e com brilho livre: o jogo decide o que desenhar.
  * `Theme.X2WR` (e não Theme.Material3.* direto) para que o android:theme do
    manifesto aponte para um nome do projeto, não para o de uma biblioteca.
-->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.X2WR" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <!-- O overlay de toque é desenhado por cima do SurfaceView; nada de
             animação de janela que possa piscar durante a transição. -->
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
    </style>

    <style name="X2WR.Button" parent="Widget.Material3.Button">
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <!-- parent="" e obrigatorio aqui: o AAPT trata "X2WR.Status" como filho
         implicito de "X2WR" (notacao de ponto) e falha o link com
         "resource style/X2WR not found". Medido no run 40733271314. -->
    <style name="X2WR.Status" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#FFE0E0E0</item>
    </style>
</resources>
